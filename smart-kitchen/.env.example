# ---------------------------------------------------------------------------
# Smart Kitchen — Environment Variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI="mongodb://localhost:27017/smart_kitchen"

# Household size — the whole app scales to this number of people.
HOUSEHOLD_SIZE=7

# --- AWS (Textract for OCR receipts, SNS for SMS cook reminders) ----------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SNS: either a pre-created Topic ARN (fan-out) or leave blank to send direct SMS
SNS_TOPIC_ARN=""

# S3 bucket used to stage receipt images for asynchronous Textract jobs (optional)
RECEIPTS_S3_BUCKET=""
