# ---------------------------------------------------------------------------
# Smart Kitchen — Environment Variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas free tier works fine, or self-hosted)
MONGODB_URI="mongodb://localhost:27017/smart_kitchen"

# --- Authentication (required) ---------------------------------------------
# Shared passcode every housemate uses to sign in. Pick something memorable
# for the house; anyone with it can join.
HOUSEHOLD_PASSCODE="change-me"
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Fallback household size used ONLY before the first member signs in.
# After that, portions scale to the number of active members automatically.
HOUSEHOLD_SIZE=7

# --- AWS (optional: OCR receipts + SMS cook reminders) ----------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SNS: optional topic ARN used only as a fallback for cooks without a phone
# number on file. Reminders normally go as direct per-cook SMS.
SNS_TOPIC_ARN=""

# S3 bucket that stages multi-page/large receipts for asynchronous Textract
# jobs. Leave blank to support single-page images (<= 10 MB) only.
RECEIPTS_S3_BUCKET=""
